APP_ENV=local
MOCK_MODE=true
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/investment_ai
REDIS_URL=redis://localhost:6379/0
JWT_ISSUER=investment-platform
JWT_AUDIENCE=investment-api
JWT_SECRET=replace-with-a-32-byte-random-secret
ACCESS_TOKEN_TTL_MINUTES=30
MAX_RESEARCH_LOOKBACK_DAYS=365
REVIEW_REQUIRED=true
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_DIMENSIONS=384
MAX_CONTEXT_CHUNKS=8
MAX_TOOL_CALLS=8
REQUEST_TIMEOUT_SECONDS=30
