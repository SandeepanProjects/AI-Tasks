# Start from .env.runtime.example and replace local database/cache endpoints with
# RDS/Aurora and ElastiCache endpoints. Inject secrets through Secrets Manager.
APP_ENV=aws
AWS_REGION=ap-south-1
AWS_S3_BUCKET=replace-with-terraform-output-bucket
AWS_S3_PREFIX=compliance-documents
AWS_KMS_KEY_ID=

# Provider selection: openai | bedrock
LLM_PROVIDER=bedrock
EMBEDDING_PROVIDER=bedrock
AWS_BEDROCK_CHAT_MODEL_ID=replace-with-a-model-enabled-in-your-region
# Titan Text Embeddings v1 returns 1536 dimensions to match the existing pgvector schema.
AWS_BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v1
EMBEDDING_DIMENSIONS=1536
AWS_BEDROCK_MAX_TOKENS=4096
AWS_BEDROCK_EMBEDDING_CONCURRENCY=4
AWS_TEXTRACT_POLL_SECONDS=5
AWS_TEXTRACT_MAX_WAIT_SECONDS=600
