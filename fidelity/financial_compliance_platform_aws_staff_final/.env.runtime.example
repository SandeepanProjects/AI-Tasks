APP_ENV=local
DATABASE_URL=postgresql+asyncpg://app_user:replace-with-a-strong-app-password@postgres:5432/compliance
SYNC_DATABASE_URL=postgresql://app_user:replace-with-a-strong-app-password@postgres:5432/compliance
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_ISSUER=financial-compliance-local
JWT_AUDIENCE=financial-compliance-api
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
MAX_AGENT_STEPS=8
MAX_EVALUATION_REWORKS=1
OUTBOX_POLL_SECONDS=5
OUTBOX_BATCH_SIZE=100
IDEMPOTENCY_KEY_MAX_LENGTH=256

# Optional AWS profile (leave blank/local to keep the Docker development stack)
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_S3_PREFIX=compliance-documents
AWS_KMS_KEY_ID=
LLM_PROVIDER=openai
EMBEDDING_PROVIDER=openai
AWS_BEDROCK_CHAT_MODEL_ID=replace-with-a-model-enabled-in-your-region
AWS_BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v1
AWS_BEDROCK_MAX_TOKENS=4096
AWS_BEDROCK_EMBEDDING_CONCURRENCY=4
AWS_TEXTRACT_POLL_SECONDS=5
AWS_TEXTRACT_MAX_WAIT_SECONDS=600
