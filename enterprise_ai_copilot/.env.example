APP_NAME=enterprise-ai-copilot
ENVIRONMENT=development
API_V1_PREFIX=/v1
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/ai_db
SYNC_DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/ai_db
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
JWT_SECRET_KEY=replace-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
MAX_INPUT_CHARS=8000
CACHE_TTL_SECONDS=120
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
HITL_RISK_THRESHOLD=0.80
